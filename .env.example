# ============================================
# 数据源配置示例
# ============================================

# 示例 1: 本地 JSON 文件（演示/校准数据）
# SHR_COLLECTOR_SOURCE=sample_json
# SHR_COLLECTOR_ENDPOINT=data/raw/calibration_set_a/market_pool.canonical.json
# SHR_COLLECTOR_CITY=shanghai
# SHR_MARKET_DATA_MODE=sample

# 示例 2: 授权 API（生产环境 - 推荐）
# SHR_COLLECTOR_SOURCE=authorized_api
# SHR_COLLECTOR_ENDPOINT=https://api.partner.com/v1/listings
# SHR_COLLECTOR_CITY=shanghai
# SHR_MARKET_DATA_MODE=live

# 示例 3: 合作伙伴完整数据源
# SHR_COLLECTOR_SOURCE=partner_feed
# SHR_COLLECTOR_ENDPOINT=https://feed.partner.com/shanghai
# SHR_COLLECTOR_CITY=shanghai
# SHR_MARKET_DATA_MODE=live

# 示例 4: 合作方每日 CSV 文件投递
# SHR_COLLECTOR_SOURCE=partner_csv
# SHR_COLLECTOR_ENDPOINT=data/inbox/shanghai_listings.csv
# SHR_COLLECTOR_CITY=shanghai
# SHR_COLLECTOR_AUTH_MODE=NONE
# SHR_MARKET_DATA_MODE=live

# ============================================
# 认证配置
# ============================================

# 方式 1: Bearer Token（最常用）
# SHR_COLLECTOR_AUTH_MODE=BEARER_TOKEN
# SHR_COLLECTOR_BEARER_TOKEN=your_api_token_here

# 方式 2: Custom Header
# SHR_COLLECTOR_AUTH_MODE=CUSTOM_HEADER
# SHR_COLLECTOR_CUSTOM_HEADER_NAME=X-API-Key
# SHR_COLLECTOR_CUSTOM_HEADER_VALUE=your_api_key_here

# 方式 3: Basic Auth
# SHR_COLLECTOR_AUTH_MODE=BASIC_AUTH
# SHR_COLLECTOR_BASIC_USERNAME=your_username
# SHR_COLLECTOR_BASIC_PASSWORD=your_password

# 方式 4: 无认证（仅用于开发）
# SHR_COLLECTOR_AUTH_MODE=NONE

# ============================================
# 采集配置
# ============================================

# 请求超时（秒）
SHR_COLLECTOR_REQUEST_TIMEOUT_SECONDS=30

# 失败重试次数
SHR_COLLECTOR_MAX_ATTEMPTS=4
SHR_COLLECTOR_MAX_OBSERVATION_AGE_HOURS=36
SHR_COLLECTOR_MIN_COMPLETE_ITEMS=1
SHR_COLLECTOR_MIN_COMPLETE_COUNT_RATIO=0.5
SHR_COLLECTOR_PARTNER_CSV_MAX_AGE_HOURS=36

# 允许不完整数据（仅用于 SAMPLE 模式）
SHR_COLLECTOR_ALLOW_COMPLETE_WITHOUT_COVERAGE=false

# ============================================
# 范围过滤（可选）
# ============================================

# 城市（必填）
SHR_COLLECTOR_CITY=shanghai

# 区（可选，留空表示全市）
# SHR_COLLECTOR_DISTRICT=xuhui

# 板块（可选，留空表示全区）
# SHR_COLLECTOR_SUBMARKET=kangjian

# 自定义查询（可选）
# SHR_COLLECTOR_QUERY=

# ============================================
# 数据模式
# ============================================

# DEMO: 演示模式，使用内置 3 套样例数据
# SAMPLE: 样本模式，使用真实但有限的数据集
# LIVE: 生产模式；仍需独立验证授权、时效与覆盖，配置值本身不提供数据
SHR_MARKET_DATA_MODE=sample

# ============================================
# 数据库和 Redis 配置
# ============================================

SHR_DATABASE_URL=postgresql+psycopg://radar:radar@db:5432/shanghai_home_radar
SHR_REDIS_URL=redis://redis:6379/0

# ============================================
# 每日自主运行
# ============================================

SHR_DAILY_SCHEDULE_TIME=02:00
SHR_DAILY_TIMEZONE=Asia/Shanghai
SHR_DAILY_RUN_ON_START=false
SHR_DAILY_CATCH_UP_ON_START=true
SHR_DAILY_RUN_LOCK_TTL_SECONDS=21600
SHR_DAILY_HEALTH_MAX_AGE_HOURS=30
SHR_DAILY_TOP_OPPORTUNITIES_LIMIT=10
SHR_DAILY_MIN_DECISION_COVERAGE_RATIO=0.95
SHR_DAILY_MAX_ATTEMPTS_PER_DAY=4
SHR_DAILY_RETRY_INITIAL_DELAY_SECONDS=900
SHR_DAILY_RETRY_MAX_DELAY_SECONDS=3600
SHR_DAILY_REPORT_DIRECTORY=data/exports/daily

# 可选。配置后，流水线失败会 POST JSON 告警。
# SHR_DAILY_ALERT_WEBHOOK_URL=https://alerts.example.com/home-radar
# SHR_DAILY_ALERT_WEBHOOK_BEARER_TOKEN=replace-me

# 可选。配置后，每次成功运行会主动投递当日 Top 榜单。投递失败会使运行失败并触发告警。
# SHR_DAILY_RESULT_WEBHOOK_URL=https://alerts.example.com/home-radar/daily
# SHR_DAILY_RESULT_WEBHOOK_BEARER_TOKEN=replace-me
SHR_DAILY_RESULT_WEBHOOK_TIMEOUT_SECONDS=10
SHR_DAILY_RESULT_WEBHOOK_MAX_ATTEMPTS=3
# P5.7 通过前保持 RESEARCH_ONLY。
SHR_DAILY_ADVISORY_STATUS=RESEARCH_ONLY

# 每天 01:00 在每日扫描前生成 PostgreSQL custom-format 备份。
SHR_BACKUP_SCHEDULE_TIME=01:00
SHR_BACKUP_RUN_ON_START=false
SHR_BACKUP_CATCH_UP_ON_START=true
SHR_BACKUP_RETENTION_DAYS=14

# LIVE 构建前由 scripts/release_fingerprint.py 生成，不要手填占位值。
# SHR_SOURCE_COMMIT=40-character-git-commit
# SHR_SOURCE_TREE_HASH=64-character-sha256

# ============================================
# 其他配置
# ============================================

# 运行环境
SHR_ENVIRONMENT=development

# API 服务端口
API_PORT=8000

# 日志级别
SHR_LOG_LEVEL=INFO
